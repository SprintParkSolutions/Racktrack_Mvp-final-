# Build context excludes — keep the image lean and reproducible.
# Anything listed here is NOT sent to the Docker daemon / not COPY-able.

# --- Node / JS ---
node_modules
client/node_modules
server/node_modules
client/dist            # rebuilt in the client-build stage
npm-debug.log*

# --- Python ---
.venv
venv
__pycache__
*.pyc
*.pyo

# --- Model weights (mounted at runtime, git-LFS, large) ---
Models
*.pt
*.pth
*.onnx

# --- Runtime data (mounted as volumes) ---
outputs
batch_outputs
server/uploads
!server/uploads/.gitkeep
active_learning_Cache/data
retraining_learning
servicenow_inbox
# servicenow/ itself IS needed — topology_generate.py + synth.py run from there.
# Only its bulk is not: 26 MB of sample scans and compiled bytecode.
servicenow/mock_scans
servicenow/__pycache__
cmdb_racks
# Agent/ and firmware_lookup/ ship (the Switches page's spec + firmware lookups
# spawn them), minus their compiled bytecode. The bare `__pycache__` line at the
# top of this file only ever matched the one at the repo root — Docker anchors a
# pattern without a wildcard, which is why servicenow's had to be named too.
Agent/**/__pycache__
firmware_lookup/**/__pycache__

# --- VCS / tooling ---
.git
.gitignore
.gitattributes
.gitleaks.toml
.github
.vscode
.idea

# --- Docs / spreadsheets / misc large assets ---
docs
*.md
*.xlsx
# ...except this one, which is a data input rather than a document. The vendor
# spec lookup reads it directly, so excluding it made /api/specs/vendors answer
# 500 "Excel not found: /app/Switch_Vendors_Websites.xlsx" on every deployed
# build — the Specifications page was broken for everyone, and only in Docker.
!Switch_Vendors_Websites.xlsx
cloudflared
netdisco-docker

# --- Secrets / env ---
.env
.env.*
*/.env
*/.env.*

# --- OS / editor cruft ---
.DS_Store
**/.DS_Store
*.log
Test_Image
hero1.png
