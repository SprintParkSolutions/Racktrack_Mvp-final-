# RackTrack — environment for the demo.racktrack.ai VPS.
#
# Copy to server/.env ON THE VPS. This is deliberately NOT a copy of the
# production server/.env. That file carries SLACK_TOKEN, JIRA_TOKEN,
# OPENROUTER_API_KEY, SWITCH_USER_PASSWORD, NETDISCO_PASSWORD and
# SSH_CREDS_ENC — live credentials for the office lab and third-party
# accounts. A public demo box has no use for any of them, and every one
# copied there is one more secret to rotate if that box is ever compromised.
#
# NODE_ENV, PORT, CORS_ALLOWED_ORIGINS and RACKTRACK_WORKERS are set in
# docker-compose.demo.yml and take precedence over anything here (compose
# `environment:` beats `env_file:`), so they are intentionally absent.

# Session-token signing key. Generate a FRESH one for the demo:
#   openssl rand -hex 32
# Do not reuse production's — a token minted on the demo would then be valid
# against the Windows box too.
JWT_SECRET=

# ── Outbound email — REQUIRED for password reset ──────────────────────
# Not optional in practice. Without a working transport the server accepts a
# forgot-password request, answers 200 (it never reveals whether an address is
# registered) and sends nothing at all: the user waits for a code that does not
# exist. Signup verification behaves the same way. Seeded tester accounts hide
# it, because they skip verification and know their password.
#
# PREFERRED — Microsoft Graph, sending as racktrackteam@sprintpark.com. These
# two ids are not secret and also live in token/mailid.md; set them here so the
# server is not reliant on that file being mounted. The refresh tokens that do
# the actual signing come from the mounted token/ directory — see the volume in
# docker-compose.demo.yml.
MS_CLIENT_ID=
MS_TENANT_ID=
# Optional: with an admin-consented app secret the server takes the
# client-credentials path and needs no mailbox refresh token at all.
# MS_CLIENT_SECRET=

# FALLBACK — plain SMTP, used only when Graph cannot produce a token.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=RackTrack <no-reply@racktrack.ai>

# Social sign-in ("Continue with Google / Apple / Facebook").
# Full walkthrough: docs/setup/SOCIAL-LOGIN-SETUP.md
#
# Leave these blank and the buttons simply never render — the server reports
# an empty provider list and the password form is unaffected. So the demo is
# perfectly usable without them.
#
# On this box the app and the API share one origin (Caddy proxies everything
# to :3001), so the redirect base IS the site URL and OAUTH_WEB_ORIGIN can be
# left unset — it defaults to OAUTH_REDIRECT_BASE.
#
# Register this exact URI in the Google console, no trailing slash:
#   https://demo.racktrack.ai/api/auth/oauth/google/callback
#
# OAUTH_REDIRECT_BASE=https://demo.racktrack.ai
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Apple and Facebook need the same treatment plus their own console setup;
# see the doc. Note FACEBOOK_TRUST_EMAIL should stay off — on a public demo
# especially, an unverified email must not be able to claim an account.

# ── Seeded Netdisco inventory ─────────────────────────────────────────
# Netdisco discovers devices on its own network, and none exists next to this
# VPS, so the Network view answered "unreachable" and looked broken rather than
# empty. With this set it answers from a small self-consistent fake network
# instead (see server/lib/demo_data.js): four devices, LLDP neighbours, learned
# MACs, PoE and VLANs, plus a counterpart for every switch in whichever rack the
# viewer has open.
#
# SCOPE — this covers the Network view and nothing else. The Lab page and the
# Live Network Switch page always open a real SSH session, in every mode, and on
# this VPS they will honestly report that they cannot reach a switch. That is
# intended: those screens promise live hardware on their face, so seeding them
# made them state invented PoE draw and link speeds as measured fact.
#
# ONLY set this on the demo. A real deployment must never present invented
# network data as though it were measured — the server logs a loud warning at
# startup whenever it is on.
RACKTRACK_DEMO_DATA=1

# ── Live switch reading ───────────────────────────────────────────────
# The switch login still works and the attempt still runs — a visitor typing
# their own switch details gets a real answer. This only makes that answer fast
# and honest: a VPS cannot route to anyone's private LAN, and without this the
# page spins for the full SSH timeout and then says "The switch didn't respond",
# sending the reader to check a switch that is fine.
#
# Remove BOTH lines once the WireGuard route to the lab is up (see
# deploy/lab-tunnel/README.md) — this box can genuinely reach a switch then.
LIVE_SWITCH_OFF_NETWORK=1
LIVE_SWITCH_NOTE=This demo isn’t on your switch’s network, so it can’t reach it. RackTrack reads switches when it runs on your network.

# ── Deliberately omitted ──────────────────────────────────────────────
# NETDISCO_URL, NETDISCO_USER, NETDISCO_PASSWORD
#     Point at the office lab. From a public VPS they either hang on an
#     unroutable private address or surface internal IPs in error text.
#     RACKTRACK_DEMO_DATA above is what fills that hole — leave these unset.
#
# SWITCH_USER_USERNAME, SWITCH_USER_PASSWORD, TPLINK_BENCH_HOST
#     The real TP-Link bench switch. Unroutable from here, and a credential
#     that reaches actual hardware must not sit on a public box. Leave unset.
#
# SSH_CREDS_ENC
#     Unset by DEFAULT, so the switch screens honestly report that they cannot
#     reach a switch — there is no fixture mode for them.
#
#     Set it only if you are deliberately wiring the demo to the real EVE-NG lab
#     over WireGuard, and then only with a dedicated lab-only credential that
#     reaches nothing else: whatever goes here is decryptable by anyone with a
#     shell on this box, because .env.key sits beside it. Full runbook, including
#     the console hardening that MUST be deployed first:
#         deploy/lab-tunnel/README.md
#
# SLACK_TOKEN, JIRA_EMAIL, JIRA_TOKEN
#     Third-party credentials the demo has no need for.
#
# OPENROUTER_API_KEY
#     Only add this if the demo must show Ask DOT, and then use a separate,
#     rate-limited key — not the production one. It is billable.
