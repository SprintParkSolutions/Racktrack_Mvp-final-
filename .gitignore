# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Python virtualenv (regenerable; contains >100MB binaries GitHub rejects)
.venv/
venv/

# Model weights — distributed separately, not version-controlled
*.pt
*.pth
*.onnx
Models/

# Local test-account credentials (plaintext password — never commit)
TEST_ACCOUNT.md

# Build artifacts
client/dist/

# Native mobile build output — regenerable, never commit (build_sim was tracked
# by mistake: 3044 files / 254 MB of Xcode simulator output).
client/ios/App/build/
client/ios/App/build_sim/
client/ios/App/DerivedData/
client/android/app/build/
client/android/build/
client/android/.gradle/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Pipeline outputs (generated at runtime)
outputs/

# Uploads (runtime data)
server/uploads/*
!server/uploads/.gitkeep

# Environment
.env
.env.local
.env.*.local
.env.key

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Server runtime state (DB backups, last-host tracking)
server/data/backups/
server/data/last-hosts/

# Scratch test artifacts at repo root (one-shot captures, leading dot)
/.benchmark_*.png
/.full_pipeline_*.png
/.test_rack_*.jpg
/.test_response.json

# ONNX fp32 sources — re-derivable from .pt files; the int8 builds we ship
# live in client/public/models/. Skipped here to keep the repo lean.
Models/exported/

# cloudflared binary — 63 MB, install via system package manager
# (winget install Cloudflare.cloudflared).
/cloudflared.exe
Models.zip

# Runtime state — regenerated by start.ps1 each run
/current-url.txt

# Personal OAuth token caches — produced by Slack/Teams/Outlook senders.
# These should never be committed (they grant access as the account that logged
# in, and the refresh token inside stays usable until it is revoked).
pipeline/*_outlook_cache.json
pipeline/*_teams_cache.json
pipeline/*_slack_cache.json
# Same files dropped at the repo root while being handed over — the patterns
# above are path-anchored to pipeline/ and would not have caught these.
/*_teams_cache.json
/*_outlook_cache.json
/*_slack_cache.json
# Azure app registration identifiers pasted in for setup.
/id.md
/supportid.md
# Handover copies of MSAL caches, whatever the mailbox is called. The patterns
# above key off the "_teams_cache" suffix; a file named after the account
# ("support@racktrack.ai_teams_cache 1.json") has a space and a trailing index
# and slipped straight past them. Match on the mailbox spelling too — each of
# these carries a refresh token that stays redeemable until revoked.
/*_cache*.json
/*teams_cache*
/*outlook_cache*

# Azure/Graph mail credentials + token caches (CLIENT_ID/TENANT_ID + access
# tokens). The whole folder is secret — never commit any of it.
token/

# Word lock files (created when a .docx is open in Microsoft Word).
~$*.docx

# Local handout/deliverable docs (sprint updates, matrices) — working files, not source.
docs/handouts/

# Old documentation archives — superseded by docs/features/.
/docs.zip
/docs/use-cases.zip
/cloudflared

# ── Secrets & runtime state (untracked 2026 — never commit) ──────────
client/.env.production
**/demo_tenant*.json
server/feedback.jsonl
server/data/last-hosts/
servicenow/mock_scans/**/feedback.jsonl

# Tester invite links (one-time codes) — do not commit
TESTER_INVITES.md
RACKTRACK_INVITES.md
server/data/racktrack-invites.json
RACKTRACK_INVITES.txt

# Local demo & tester materials (scripts, packets, credentials) — not for version control
demo/
testers/
THE-TESTERS_INVITES.txt

# Outlook token cache in any location (leak guard)
*_outlook_cache.json

# Local secrets/credentials — never version control
.secrets/

# Atlassian API token — never commit
atl_api.md
atl_token.txt

# Confluence page backup (local safety copy)
.confluence_backup_*/
client/.firebase-app-id
server/.env
server/.env.key
acc.md
apple.txt

# Apple App Store Connect API private key(s) — NEVER commit (grants build upload)
*.p8
AuthKey_*.p8

# Runtime server logs DB (LogsPage)
server/data/logs.db
server/data/logs.db-shm
server/data/logs.db-wal

# Retraining image artifacts — regenerable training data / run outputs.
# The retraining .py scripts and .md docs stay tracked; only the data is ignored.
retraining_learning/Devices_Retraining/temp/
retraining_learning/Devices_Retraining/runs/
retraining_learning/Devices_Retraining/review_dataset/images/

# Support assistant refusal log — real user questions, so treat as user data.
# The knowledge base itself (server/data/support-kb.json) IS tracked: it is
# product knowledge, not user data.
server/data/support-refusals.jsonl
server/data/support-refusals.*.jsonl

# Database files and their backups — contain password hashes and tenant data
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/*.bak*
server/data/*.pre-repoint*

# Tester credential handout — generated by server/scripts/seed-testers.js
TESTER-CREDENTIALS.md

# Jira API token — never commit
jira.md

# Signing key material and the JWT secret. jwt.secret was protected only by
# .git/info/exclude, which is machine-local and never travels — which is how a
# live signing key reached a pushed branch. Keystores are latent: none exist
# today, but the Android release path will create one.
server/data/jwt.secret
*.secret
*.jks
*.keystore
*.p12
*.mobileprovision

# firmware_lookup runtime HTTP cache — not source
firmware_lookup/cache_dir/

# Support-bot working folders — the handoff package and the R&D copy. Both
# carry a .env with live API keys (Groq / Gemini / OpenRouter) and ~26 MB of
# KB/embeddings/docx. Never commit — integration lands in server/ + client/.
support-bot2/
racktrack-support-bot/

# Secrets and bulk artefacts that must never enter history.
# auth_ngrok holds a live ngrok authtoken; server.zip is a 101 MB snapshot.
auth_ngrok
server.zip
*.p8

# The tester roster: real personal email addresses paired with plaintext
# passwords for the demo deployment. This was committed as scripts/
# tester-accounts.js until the move to a public repo, and had to be purged
# from history. The loader (scripts/tester-accounts.js) reads this file and
# fails with instructions when it is absent; tester-roster.example.json is the
# committed template. Never commit the real one.
server/scripts/tester-roster.json

# Raw video takes dropped at the repo root while picking home-page footage.
# The chosen ones live tracked in client/public/; the root copies are staging
# material only.
/*.mp4

# Scratch drawer for everything that lives beside the project but is not the
# project: sales collateral, presentation exports, superseded snapshots and
# stale auth caches. Nothing here is read by the build or by any script — the
# live credential paths stay where the code expects them (token/,
# TESTER-CREDENTIALS.md, pipeline/racktrack_teams_cache.json).
_local/

# Vitest coverage output - regenerated by `npm test -- --coverage`, never shipped.
client/coverage/

# The raw 3D model as supplied (3.2 MB, 55 oversized textures). The version the
# app actually ships is client/public/racktrack-bot.glb - greyscaled to the app
# theme and resized for mobile, 0.9 MB. Keep the original out of the tree.
cute+robot+3d+model_Clone1.glb
